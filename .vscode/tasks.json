		{
			"label": "Stop duplicate Git upload",
			"type": "shell",
			"command": "Get-CimInstance",
			"args": [
				"Win32_Process",
				"-Filter",
				"name='git.exe'",
				"|",
				"Where-Object",
				"{",
				"$_.CommandLine",
				"-match",
				"'push origin 518ee252'",
				"}",
				"|",
				"ForEach-Object",
				"{",
				"Stop-Process",
				"-Id",
				"$_.ProcessId",
