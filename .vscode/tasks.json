{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Jekyll Server",
			"type": "shell",
			"command": "./tools/run.sh",
			"windows": {
				"options": {
					"shell": {
						"executable": "C:\\Program Files\\Git\\bin\\bash.exe",
						"args": [
							"-lc"
						]
					}
				}
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"detail": "Runs the Jekyll server with live reload."
		},
		{
			"label": "Build Jekyll Site",
			"type": "shell",
			"command": "./tools/test.sh",
			"windows": {
				"options": {
					"shell": {
						"executable": "C:\\Program Files\\Git\\bin\\bash.exe",
						"args": [
							"-lc"
						]
					}
				}
			},
			"group": {
				"kind": "build"
			},
			"problemMatcher": [],
			"detail": "Build the Jekyll site for production."
		},
		{
			"label": "Build JS (watch)",
			"type": "shell",
			"command": "npm run watch:js",
			"windows": {
				"command": "npm.cmd run watch:js"
			},
			"group": {
				"kind": "build"
			},
			"problemMatcher": [],
			"detail": "Build JS files in watch mode."
		},
		{
			"label": "Build CSS",
			"type": "shell",
			"command": "npm run build:css",
			"windows": {
				"command": "npm.cmd run build:css"
			},
			"group": {
				"kind": "build"
			},
			"problemMatcher": [],
			"detail": "Build CSS files."
		},
		{
			"label": "Build JS & CSS",
			"type": "shell",
			"command": "npm run build",
			"windows": {
				"command": "npm.cmd run build"
			},
			"group": {
				"kind": "build"
			},
			"problemMatcher": [],
			"detail": "Build JS & CSS for production."
		},
		{
			"label": "Run Jekyll Server + Build JS (watch)",
			"dependsOn": [
				"Run Jekyll Server",
				"Build JS (watch)"
			],
			"group": {
				"kind": "build"
			},
			"detail": "Runs both the Jekyll server with live reload and build JS files in watch mode."
		},
		{
			"label": "Build Course Pages",
			"type": "shell",
			"command": "bundle exec jekyll build --config _config.yml,tools/course-build.yml --trace",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Lint Course JS",
			"type": "shell",
			"command": "npx.cmd eslint _javascript/modules/course.js _javascript/post.js",
			"isBackground": false,
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "test"
		},
		{
			"label": "Validate Course Pages",
			"type": "shell",
			"command": "bundle exec ruby tools/validate-courses.rb _site",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Push Course Notes Deployment",
			"type": "shell",
			"command": "git push origin master",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify Course Push",
			"type": "shell",
			"command": "git ls-remote origin refs/heads/master",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Retry Course Notes Deployment",
			"type": "shell",
			"command": "git -c http.version=HTTP/1.1 -c http.postBuffer=524288000 push origin master",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify remote master SHA",
			"type": "shell",
			"command": "git",
			"args": [
				"-c",
				"http.version=HTTP/1.1",
				"ls-remote",
				"origin",
				"refs/heads/master"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Push course library commit",
			"type": "shell",
			"command": "git",
			"args": [
				"-c",
				"http.version=HTTP/1.1",
				"-c",
				"http.postBuffer=524288000",
				"push",
				"origin",
				"master"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Inspect course commit ancestry",
			"type": "shell",
			"command": "git",
			"args": [
				"show",
				"--no-patch",
				"--format=%H%n%P%n%s",
				"518ee252ef76630fd25a7d61d0c645436c1c5245"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
