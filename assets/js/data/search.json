---
layout: compress
swcache: true
---

[
  {% assign search_documents = site.posts | concat: site.courses %}
  {% for post in search_documents %}
  {% if post.type == 'course' %}
    {% assign course_meta = site.data.courses[post.course] %}
    {% assign context_title = course_meta.short_title %}
  {% else %}
    {% assign series_meta = site.data.series[post.series] %}
    {% assign context_title = series_meta.title | default: post.series | replace: '-', ' ' %}
  {% endif %}
  {% assign visible_topics = '' | split: '' %}
  {% for topic in post.topics %}
    {% unless site.garden.hidden_topics contains topic %}
      {% assign visible_topics = visible_topics | push: topic %}
    {% endunless %}
  {% endfor %}
  {
    "uid": {{ post.uid | jsonify }},
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "type": {{ post.type | jsonify }},
    "status": {{ post.status | jsonify }},
    "contentLang": {{ post.content_lang | jsonify }},
    "series": {{ post.series | jsonify }},
    "seriesTitle": {{ context_title | jsonify }},
    "topics": {{ visible_topics | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date": {{ post.updated | default: post.date | default: '1970-01-01' | date: '%Y-%m-%d' | jsonify }},
    "excerpt": {{ post.garden_search_excerpt | jsonify }},
    "content": {{ post.garden_search_text | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
