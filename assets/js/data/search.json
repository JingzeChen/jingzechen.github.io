---
layout: compress
swcache: true
---

[
  {% for post in site.posts %}
  {% assign series_meta = site.data.series[post.series] %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "type": {{ post.type | jsonify }},
    "series": {{ post.series | jsonify }},
    "seriesTitle": {{ series_meta.title | default: post.series | replace: '-', ' ' | jsonify }},
    "topics": {{ post.topics | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date": {{ post.date | jsonify }},
    "excerpt": {{ post.garden_search_excerpt | jsonify }},
    "content": {{ post.garden_search_text | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
