---
layout: compress
permalink: /assets/js/data/reading.json
---

[
  {% assign reading_posts = site.posts | where: 'type', 'reading' %}
  {% for post in reading_posts %}
    {% assign series_meta = site.data.series[post.series] %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "series": {{ post.series | jsonify }},
      "seriesTitle": {{ series_meta.title | default: post.series | replace: '-', ' ' | jsonify }},
      "seriesOrder": {{ post.series_order | jsonify }},
      "topics": {{ post.topics | jsonify }},
      "contentLang": {{ post.content_lang | jsonify }},
      "description": {% if post.garden_description_valid %}{{ post.description | jsonify }}{% else %}""{% endif %},
      "published": {{ post.date | date: '%Y-%m-%d' | jsonify }},
      "updated": {{ post.updated | default: post.date | date: '%Y-%m-%d' | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]